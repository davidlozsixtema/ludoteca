        <script language="javascript" type="text/javascript">
            function loadTagsURLS(){
                var nofollowTagLinks = true;
                $("li.productsTags span").each(function(){
                    var tagsTypesId = $(this).attr('data-tags-types-id');
                    var dataTagsIdStr = (typeof tagsTypesId !== 'undefined' && tagsTypesId !== null && $.trim(tagsTypesId) !== '')
                        ? " data-tags-types-id='" + tagsTypesId + "'"
                        : ' data-tags-types-id="null"';
                    var url = $(this).data('url');
                    var nombre = $(this).html();
                    var tagsTypeIdNum = parseInt(tagsTypesId, 10);
                    var isIndexableTag = tagsTypeIdNum === 1 || tagsTypeIdNum === 2 || tagsTypeIdNum === 3;
                    var relAttr = (!isIndexableTag && nofollowTagLinks && typeof url === 'string' && url.indexOf('/tag/') !== -1) ? ' rel="nofollow"' : '';
                    var link = "<a href='" + url + "'" + dataTagsIdStr + relAttr + ">" + nombre + "</a>";
                    $(this).parent('li').html(link);
                });
            }
            //Texto para cambiar la versión de visualización del usuario (Responsive).
            jQuery(document).ready(function() {
                                var idProductoRecomendado = $('input[type="hidden"][name="products_id"]').val();
                // console.log(idProductoRecomendado);
