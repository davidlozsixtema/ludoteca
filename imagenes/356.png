        <script>
        (function() {
            var consentCookie = 'lawwwing-consent-v2';

            function hasConsentCookie() {
                var parts = document.cookie ? document.cookie.split(';') : [];
                for (var i = 0; i < parts.length; i++) {
                    if (parts[i].trim().indexOf(consentCookie + '=') === 0) {
                        return true;
                    }
                }
                return false;
            }

            function showLawwwingBanner() {
                if (window.Lawwwing && window.Lawwwing.sdk && typeof window.Lawwwing.sdk.show === 'function') {
                    window.Lawwwing.sdk.show(1);
                }
            }

            if (!hasConsentCookie()) {
                if (window.Lawwwing && window.Lawwwing.sdk) {
                    showLawwwingBanner();
                } else {
                    document.addEventListener('lawwwing:ui:ready', showLawwwingBanner);
                }
            }
        })();
