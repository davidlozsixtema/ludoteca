        <script type="text/javascript">
            // <!-- START - PROBLEMA: ATRIBUTO "MAXLENGTH" NO FUNCIONA EN NAVEGADORES DE MOVILES -->
            var $input = $('input[maxlength]');
            $input.keyup(function(e) {
                var valor = $(this).val();
                var max = $(this).attr('maxlength');
                if(max=="") max=99; // Si no hay colocado ningun valor permito rellenar cualquier cosa
                if (valor.length > max) {
                    $(this).val(valor.substr(0, max));
                }
            });
            // <!-- END - PROBLEMA: ATRIBUTO "MAXLENGTH" NO FUNCIONA EN NAVEGADORES DE MOVILES -->
            function forceUppercaseTextFields(){
                var productos = ['18499','18500','18501','28836','28835','28830','28829','29137','29140'];
                var products_id = '80210';
                if(productos.indexOf(products_id, productos) !== -1){
                    $('input[maxlength]').keyup(function(e) {
                        $(this).val(this.value.toUpperCase());
                    });
                }
            }
            forceUppercaseTextFields();
        </script>
        
        <style>
    .bizum-pending-orders-modal {
        position: fixed;
        inset: 0;
        z-index: 10050;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
    }
    .bizum-pending-orders-modal__backdrop {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        cursor: pointer;
    }
    .bizum-pending-orders-alert {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 650px;
        background: #f2dede;
        border: 1px solid #e8bcbc;
        color: #b94a48;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.18);
        font-size: 14px;
        line-height: 1.45;
        border-radius: 8px;
    }
    .bizum-pending-orders-alert__inner {
        margin: 0 auto;
        padding: 24px 48px 24px 16px;
        position: relative;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 24px;
        flex-direction: column;
    }
    .bizum-pending-orders-alert__title {
        margin: 0;
        max-width: 450px;
        font-size: 18px;
        font-weight: 700;
        line-height: 1.3;
        text-align: center;
    }
    .bizum-pending-orders-alert__message {
        margin: 0;
        max-width: 450px;
        text-align: center;
    }
    .bizum-pending-orders-alert__link {
        background: #e59eaf;
        padding: 10px 20px;
        border-radius: 5px;
        text-decoration: none;
        font-weight: 400;
        color: black;
        font-size: 16px;
    }
    .bizum-pending-orders-alert__link:hover {
        color: white;
    }
    .bizum-pending-orders-alert__close {
        position: absolute;
        top: 8px;
        right: 12px;
        border: 0;
        background: transparent;
        font-size: 26px;
        line-height: 1;
        color: #b94a48;
        cursor: pointer;
        padding: 4px 8px;
    }
    body.bizum-pending-orders-modal-open {
        overflow: hidden;
    }
</style>
<script>
    (function() {
        var config = {
            enabled: false,
            skipAlert: false        };

        function fetchPedidosBizumPendientes() {
            return fetch("ajaxGetPedidosPendientesPagoBizum.php", {
                method: "POST",
                credentials: "same-origin",
                headers: { "X-Requested-With": "XMLHttpRequest" }
            })
            .then(function(response) { return response.json(); });
        }

        function actualizarMenuPedidosBizumPendientes(data) {
            var menuItem = document.getElementById("menu-pending-orders");
            if (!menuItem) {
                return;
            }
            menuItem.style.display = "none";
            if (data && data.estado === "ok" && data.tienePedidosPendientes) {
                menuItem.style.removeProperty("display");
            }
        }

        function mostrarAlertaPedidosBizumPendientes(data) {
            if (!config.enabled || config.skipAlert) {
                return;
            }
            if (!data || data.estado !== "ok" || !data.tienePedidosPendientes || !data.url) {
                return;
            }
            if (document.getElementById("bizum-pending-orders-modal")) {
                return;
            }

            var modalEl = document.createElement("div");
            modalEl.id = "bizum-pending-orders-modal";
            modalEl.className = "bizum-pending-orders-modal";

            var backdrop = document.createElement("div");
            backdrop.className = "bizum-pending-orders-modal__backdrop";
            backdrop.setAttribute("aria-hidden", "true");

            var alertEl = document.createElement("div");
            alertEl.id = "bizum-pending-orders-alert";
            alertEl.className = "bizum-pending-orders-alert";
            alertEl.setAttribute("role", "dialog");
            alertEl.setAttribute("aria-modal", "true");
            alertEl.setAttribute("aria-labelledby", "bizum-pending-orders-alert-title");

            var inner = document.createElement("div");
            inner.className = "bizum-pending-orders-alert__inner";

            if (data.title) {
                var title = document.createElement("p");
                title.id = "bizum-pending-orders-alert-title";
                title.className = "bizum-pending-orders-alert__title";
                title.textContent = data.title;
                inner.appendChild(title);
            }

            var message = document.createElement("p");
            message.className = "bizum-pending-orders-alert__message";
            message.textContent = data.mensaje || "";

            var link = document.createElement("a");
            link.className = "bizum-pending-orders-alert__link";
            link.href = data.url;
            link.textContent = data.enlaceTexto || data.url;

            var closeBtn = document.createElement("button");
            closeBtn.type = "button";
            closeBtn.className = "bizum-pending-orders-alert__close";
            closeBtn.setAttribute("aria-label", data.cerrarTexto || "Cerrar");
            closeBtn.innerHTML = "&times;";

            function cerrarAlerta() {
                if (modalEl.parentNode) {
                    modalEl.parentNode.removeChild(modalEl);
                }
                document.body.classList.remove("bizum-pending-orders-modal-open");
            }

            closeBtn.addEventListener("click", cerrarAlerta);
            backdrop.addEventListener("click", cerrarAlerta);

            inner.appendChild(message);
            inner.appendChild(link);
            inner.appendChild(closeBtn);
            alertEl.appendChild(inner);
            modalEl.appendChild(backdrop);
            modalEl.appendChild(alertEl);
            document.body.insertBefore(modalEl, document.body.firstChild);
            document.body.classList.add("bizum-pending-orders-modal-open");
        }

        function initPedidosBizumPendientesUI() {
            if (!config.enabled) {
                return;
            }
            fetchPedidosBizumPendientes()
                .then(function(data) {
                    actualizarMenuPedidosBizumPendientes(data);
                    mostrarAlertaPedidosBizumPendientes(data);
                })
                .catch(function() {});
        }

        document.addEventListener("DOMContentLoaded", initPedidosBizumPendientesUI);
    })();
</script><script type='text/javascript' src='js/tools/countdown.1.1.min.js?v=1792666429'></script><script>countdown(String(new Date().getTime() + 9270000), '#horasPremium', '#minPremium', '#segPremium');</script>
